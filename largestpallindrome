class Solution(object):
    def largestPalindrome(self, n):
        """
        :type n: int
        :rtype: int
        """
        if n == 1:
            return 9

        upper = 10 ** n - 1
        lower = 10 ** (n - 1)

        for i in range(upper, lower - 1, -1):
            s = str(i)
            palindrome = int(s + s[::-1])

            for j in range(upper, lower - 1, -1):
                if j * j < palindrome:
                    break

                if palindrome % j == 0:
                    other = palindrome // j

                    if lower <= other <= upper:
                        return palindrome % 1337

        return 0
