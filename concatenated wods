class Solution(object):
    def findAllConcatenatedWordsInADict(self, words):
        """
        :type words: List[str]
        :rtype: List[str]
        """
        word_set = set(words)
        memo = {}

        def can_form(word):
            if word in memo:
                return memo[word]

            dp = [False] * (len(word) + 1)
            dp[0] = True

            for i in range(1, len(word) + 1):
                for j in range(i):
                    if dp[j] and word[j:i] in word_set:
                        dp[i] = True
                        break

            memo[word] = dp[len(word)]
            return memo[word]

        result = []

        for word in sorted(words, key=len):
            word_set.remove(word)

            if can_form(word):
                result.append(word)

            word_set.add(word)

        return result
