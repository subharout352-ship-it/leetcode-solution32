class Solution(object):
    def licenseKeyFormatting(self, s, k):
        """
        :type s: str
        :type k: int
        :rtype: str
        """
        s = s.replace("-", "").upper()

        result = []
        first = len(s) % k

        if first > 0:
            result.append(s[:first])

        for i in range(first, len(s), k):
            result.append(s[i:i + k])

        return "-".join(result)
