class Solution(object):
    def totalHammingDistance(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        total = 0

        for i in range(32):
            ones = 0

            for num in nums:
                if num & (1 << i):
                    ones += 1

            zeros = n - ones
            total += ones * zeros

        return total
